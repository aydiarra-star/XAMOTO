{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "@xamoto/shared": ["./shared/src/index.ts"],
      "@xamoto/diagnostic": ["./diagnostic/src/index.ts"],
      "@xamoto/obd": ["./obd/src/index.ts"],
      "@xamoto/ai": ["./ai/src/index.ts"]
    }
  },
  "include": [
    "shared/src/**/*.ts",
    "obd/src/**/*.ts",
    "diagnostic/src/**/*.ts",
    "ai/src/**/*.ts",
    "backend/src/**/*.ts",
    "scripts/**/*.ts",
    "tests/smoke.ts",
    "tests/api-shapes.mts",
    "shared/test/**/*.ts",
    "obd/test/**/*.ts",
    "diagnostic/test/**/*.ts",
    "ai/test/**/*.ts"
  ]
}
