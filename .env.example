# ─────────────────────────────────────────────────────────────
# XAMOTO — variables d'environnement
# Copier en `.env` puis adapter. Aucune clé n'est obligatoire :
# sans clé LLM, XAMOTO fonctionne en mode « IA déterministe »
# (réponses composées depuis le moteur de règles + base documentaire,
#  zéro hallucination possible).
# ─────────────────────────────────────────────────────────────

# --- Serveur -------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
XAMOTO_PUBLIC_URL=http://localhost:3000

# --- Sécurité ------------------------------------------------
# Secret de signature des jetons de session. OBLIGATOIRE en production.
XAMOTO_JWT_SECRET=change-me-in-production-please-use-a-long-random-string
XAMOTO_SESSION_TTL_HOURS=720

# --- Base de données -----------------------------------------
# Par défaut : SQLite embarqué (local-first, zéro dépendance).
XAMOTO_DB_PATH=./data/xamoto.sqlite
# Production : PostgreSQL / Supabase (voir database/migrations/postgres).
# DATABASE_URL=postgresql://user:password@host:5432/xamoto

# --- IA ------------------------------------------------------
# Fournisseur optionnel : openai | anthropic | none
XAMOTO_LLM_PROVIDER=none
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Endpoint compatible OpenAI auto-hébergé (optionnel) :
# XAMOTO_LLM_BASE_URL=

# --- Divers --------------------------------------------------
XAMOTO_RATE_LIMIT_MAX=300
XAMOTO_LOG_LEVEL=info
